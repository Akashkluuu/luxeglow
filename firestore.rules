rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: userId (UID)
    // Fields: uid, email, displayName, photoURL, role, createdAt
    //
    // Collection: products
    // Document ID: productId
    // Fields: name, description, price, category, image, stock
    //
    // Collection: orders
    // Document ID: orderId
    // Fields: userId, items, total, status, createdAt
    //
    // Collection: chats/{chatId}/messages
    // Document ID: messageId
    // Fields: chatId, senderId, text, timestamp
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "uxuidesigner.in@gmail.com" && request.auth.token.email_verified == true));
    }

    // User Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'user';
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
    }

    // Product Rules
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Order Rules
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Chat Rules
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (chatId == request.auth.uid || isAdmin());
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (chatId == request.auth.uid || isAdmin());
      }
    }
  }
}
